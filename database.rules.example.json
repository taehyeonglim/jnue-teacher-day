{
  "rules": {
    "state": {
      ".write": "newData.child('k').isString() && newData.child('k').val().beginsWith('HOST_KEY_HERE:') && newData.child('k').val() !== data.child('k').val() && newData.child('v').isString()",
      "v": {
        ".read": true
      },
      "h": {
        ".read": true,
        "$cid": {
          ".validate": "newData.val() === true"
        }
      },
      "qh": {
        ".read": true,
        "$q": {
          ".validate": "newData.val() === true"
        }
      }
    },
    "votes": {
      ".read": true,
      "$s": {
        "$cid": {
          ".write": "root.child('state/v').val() === $s + ':vote'",
          ".validate": "newData.isString() && newData.val().matches(/^[ABCD]$/)"
        }
      }
    },
    "presence": {
      ".read": true,
      "$cid": {
        ".write": true,
        ".validate": "newData.val() === true"
      }
    },
    "nicks": {
      ".read": true,
      "$cid": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
      }
    },
    "questions": {
      ".read": true,
      "$q": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').isString() && newData.child('t').val().length >= 1 && newData.child('t').val().length <= 120 && newData.child('at').val() === now",
        "t": {
          ".validate": true
        },
        "at": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
